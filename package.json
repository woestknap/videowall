{
  "name": "videowall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "signaling": "node --env-file-if-exists=.env server/signaling/index.js",
    "test:signaling": "node --test tests/signaling.test.mjs tests/signalingConfig.test.mjs",
    "test:media": "node --experimental-strip-types --test tests/mediaBackend.test.mjs tests/mediaLibrary.test.mjs tests/converterProfile.test.mjs",
    "test:playlists": "node --experimental-strip-types --test tests/playlists.test.mjs",
    "test:manual-scenes": "node --experimental-strip-types --test tests/manualSceneRuntime.test.mjs",
    "test:playlist-runtime": "node --experimental-strip-types --test tests/playlistRuntime.test.mjs tests/playerDebug.test.mjs",
    "test:video-sync": "node --experimental-strip-types --test tests/videoSync.test.mjs",
    "test:recovery": "node --experimental-strip-types --test tests/recovery.test.mjs",
    "test:geometry": "node --experimental-strip-types --test tests/wallGeometry.test.mjs tests/virtualWallGeometry.test.mjs tests/virtualSceneRendering.test.mjs tests/editorSceneGeometry.test.mjs tests/physicalWallLayout.test.mjs tests/editorZoom.test.mjs tests/editorGuideCss.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
