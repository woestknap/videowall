# Browser / Vite (safe to expose in the browser bundle).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_SIGNALING_URL=ws://localhost:8787

# Signaling service only. Never prefix the service-role key with VITE_.
# Use ws:// only for localhost development; production must use wss://.
SIGNALING_PORT=8787
SIGNALING_HOST=0.0.0.0
PUBLIC_SIGNALING_URL=ws://localhost:8787
SIGNALING_ALLOWED_ORIGINS=http://localhost:5173
SIGNALING_MAX_CONNECTIONS=200
SIGNALING_MAX_SESSIONS=100
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
