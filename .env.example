# Browser / Vite values. These are compiled into the browser bundle and must be
# safe to expose. Configure the same four names separately in Cloudflare Pages
# Preview and Production environments.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Local/LAN example: ws://192.168.1.50:8787
# Preview/production example: wss://signal.example.com
VITE_SIGNALING_URL=ws://localhost:8787
# Optional comma-separated STUN URLs. Empty still permits LAN host candidates.
VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Signaling service only. Never configure these in Cloudflare Pages and never
# prefix SUPABASE_SERVICE_ROLE_KEY with VITE_. PUBLIC_SIGNALING_URL is written
# into player discovery leases and must be reachable by every Pi.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8787
# Local/LAN example: ws://192.168.1.50:8787
# Named-tunnel production example: wss://signal.example.com
PUBLIC_SIGNALING_URL=ws://localhost:8787
# Required comma-separated exact browser origins; wildcards are rejected.
SIGNALING_ALLOWED_ORIGINS=http://localhost:5173,https://videowall.example.com
SIGNALING_MAX_CONNECTIONS=200
SIGNALING_MAX_SESSIONS=100
